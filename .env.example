# ============================================
# HomeAssist Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================

# ===========================================
# REQUIRED - Core API Keys
# ===========================================

# OpenAI API Key (for response generation, OpenAI TTS if enabled, and news analysis)
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini API Key (for email summarization)
GEMINI_API_KEY=your-gemini-key-here

# AssemblyAI API Key (for speech transcription)
ASSEMBLYAI_API_KEY=your-assemblyai-key-here

# ===========================================
# REQUIRED - Supabase (Database)
# ===========================================

# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (not the anon key!)
SUPABASE_KEY=your-supabase-service-role-key

# ===========================================
# OPTIONAL - News API (for news summarizer)
# ===========================================
# Get free keys at https://newsapi.org
# Multiple keys allow rotation when quota exhausted

NEWS_API_KEY_1=your-first-newsapi-key
NEWS_API_KEY_2=your-second-newsapi-key
NEWS_API_KEY_3=your-third-newsapi-key
NEWS_API_KEY_4=your-fourth-newsapi-key
NEWS_API_KEY_5=your-fifth-newsapi-key

# ===========================================
# OPTIONAL - Smart Home & Integrations
# ===========================================

# Spotify (leave empty to disable)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Target device ID for playback (get this by running the spotify_playback tool with action: "devices")
# This allows the assistant to auto-activate your Mac as a playback device
SPOTIFY_DEVICE_ID=

# ===========================================
# OPTIONAL - Discord Bot
# ===========================================

# Discord bot token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=
# Channel ID the bot listens and responds in
DISCORD_CHANNEL_ID=
# Dedicated channel ID for proactive briefing posts
DISCORD_BRIEFING_CHANNEL_ID=
# Dedicated channel ID for /todo slash commands
DISCORD_TODO_CHANNEL_ID=

# ===========================================
# OPTIONAL - Tool-Calling Mini (self-hosted tool routing)
# ===========================================

# Refresh token shared with the Tool-Calling Mini inference server
# Used for HMAC-SHA256 rotating API keys (5-minute TTL)
INFERENCE_REFRESH_TOKEN=
# URL of your Tool-Calling Mini inference server (default: http://localhost:8000)
# TOOL_CALLING_MINI_URL=https://<your-inference-server>

# ===========================================
# OPTIONAL - User Configuration
# ===========================================

# Primary user's name (default: User). Every per-user default below falls back
# to it: notification recipients, weather/briefing user, todos, Spotify user,
# and the Google OAuth token name (creds/token_<name>.json, GCAL_REFRESH_TOKEN_<NAME>).
HOMEASSIST_USER_NAME=User
# Other household members (comma-separated), e.g. for shared briefings/notifications
# HOMEASSIST_OTHER_USERS=

# Per-feature overrides (default: HOMEASSIST_USER_NAME)
# EMAIL_NOTIFICATION_RECIPIENT=
# NEWS_NOTIFICATION_RECIPIENT=
# WEATHER_USER_ID=
# DEFAULT_ASSISTANT_USER=

# Who built the assistant, as told to the model (default: a generic line)
# ASSISTANT_CREATOR=
# Extra words for AssemblyAI to prioritize, e.g. names (comma-separated)
# TRANSCRIPTION_WORD_BOOST=
# Transcription spelling fixes as JSON: {"Correct": ["wrong1", "wrong2"]}
# TRANSCRIPTION_CUSTOM_SPELLING=

# Remote console dashboard endpoint (console logging is off unless both are set)
# CONSOLE_DASHBOARD_URL=https://<your-dashboard>/api/console/log
# CONSOLE_TOKEN=

# Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash


# ===========================================
# OPTIONAL - Additional providers
# ===========================================

# Anthropic API key (only if you switch a provider to Claude)
ANTHROPIC_API_KEY=
# SerpAPI key (web search tool)
SERPAPI_API_KEY=

# ===========================================
# OPTIONAL - Google Calendar
# ===========================================

# Path to the service account JSON (default: creds/homeassist-google-service.json)
# GOOGLE_SERVICE_ACCOUNT_FILE=creds/your-service-account.json
# Calendar IDs (owner email for a main calendar, or ...@group.calendar.google.com)
CALENDAR_ID_PERSONAL=you@example.com
CALENDAR_ID_SCHOOL=
CALENDAR_ID_CLUB=
CALENDAR_ID_HOMEASSIST=

# ===========================================
# OPTIONAL - Gmail (email summarizer, headless/CI mode)
# ===========================================

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ===========================================
# OPTIONAL - Home devices (personal values stay out of source control)
# ===========================================

# Default phone number for SMS/iMessage notifications (E.164, e.g. +15555550123)
SMS_PHONE_NUMBER=
# LAN IP addresses of the two Kasa smart lights
KASA_LIGHT_ONE_IP=
KASA_LIGHT_TWO_IP=
# Bluetooth address of the audio device kept connected by the background service
# (find it with: blueutil --paired)
HOMEASSIST_BT_DEVICE_ADDRESS=
